    def kde(self, data: _Numeric1D, style: StyleDict | None = None) -> None: ...
    def ecdf(self, data: _Numeric1D, style: StyleDict | None = None) -> None: ...
    def contour(
        self,
        x: _Numeric1D,
        y: _Numeric1D,
        z: _Numeric1D,
        style: StyleDict | None = None,
    ) -> None: ...
    def pie(self, values: _Numeric1D, labels: Sequence[str] | None) -> None: ...
    def radar(
