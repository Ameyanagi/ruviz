"""Type stubs for the compiled ``ruviz._native`` extension module.

Every method mirrors one ``#[pymethods]`` entry in ``bindings/python/src``.
Numeric arguments accept any float sequence; a C-contiguous ``float64`` NumPy
array is copied straight into ``Vec<f64>``. The ``style`` mappings carry the
validated per-series options.
"""

from collections.abc import Sequence

import numpy as np
import numpy.typing as npt

from ._typing import StyleDict

#: Any accepted numeric vector; float64 arrays take the zero-conversion path.
_Numeric1D = Sequence[float] | npt.NDArray[np.float64]

#: Any accepted numeric matrix.
_Numeric2D = Sequence[Sequence[float]] | npt.NDArray[np.float64]

def version() -> str:
    """Return the compiled crate version."""

class NativeObservable1D:
    """Mutable numeric source shared with the renderer."""

    def __init__(self, values: _Numeric1D) -> None: ...
    def replace(self, values: _Numeric1D) -> None: ...
    def set_at(self, index: int, value: float) -> None: ...

_NumericSource = _Numeric1D | NativeObservable1D

class NativePlotHandle:
    """Incrementally built 2D plot backed by the core ``Plot`` builder."""

    def __init__(self) -> None: ...
    def size_px(self, width: int, height: int) -> None: ...
    def size(self, width_in: float, height_in: float) -> None: ...
    def dpi(self, dpi: int) -> None: ...
    def max_resolution(self, max_width: int, max_height: int) -> None: ...
    def font_size(self, points: float) -> None: ...
    def title_size(self, points: float) -> None: ...
    def font_family(self, family: str) -> None: ...
    def scale_typography(self, factor: float) -> None: ...
    def line_width_pt(self, points: float) -> None: ...
    def margin(self, fraction: float) -> None: ...
    def tight_layout_pad(self, points: float) -> None: ...
    def scientific_notation(self, enabled: bool) -> None: ...
    def fast(self, enabled: bool) -> None: ...
    def theme(self, theme: str) -> None: ...
    def ticks(self, enabled: bool) -> None: ...
    def title(self, title: str) -> None: ...
    def xlabel(self, label: str) -> None: ...
    def ylabel(self, label: str) -> None: ...
    def legend(self, position: str) -> None: ...
    def grid(self, enabled: bool) -> None: ...
    def xlim(self, min: float, max: float) -> None: ...
    def ylim(self, min: float, max: float) -> None: ...
    def xscale(self, scale: str, linthresh: float | None = None) -> None: ...
    def yscale(self, scale: str, linthresh: float | None = None) -> None: ...
    def line(
        self, x: _NumericSource, y: _NumericSource, style: StyleDict | None = None
    ) -> None: ...
    def scatter(
        self, x: _NumericSource, y: _NumericSource, style: StyleDict | None = None
    ) -> None: ...
    def bar(
        self,
        categories: Sequence[str],
        values: _NumericSource,
        style: StyleDict | None = None,
    ) -> None: ...
    def histogram(self, data: _NumericSource, style: StyleDict | None = None) -> None: ...
    def boxplot(self, data: _NumericSource, style: StyleDict | None = None) -> None: ...
    def heatmap(self, values: _Numeric1D, rows: int, cols: int) -> None: ...
    def error_bars(
        self,
        x: _NumericSource,
        y: _NumericSource,
        y_errors: _NumericSource,
        style: StyleDict | None = None,
    ) -> None: ...
    def error_bars_xy(
        self,
        x: _NumericSource,
