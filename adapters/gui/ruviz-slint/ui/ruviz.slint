export enum RuvizImageFit {
    contain,
    cover,
    fill,
}

export enum RuvizContextAction {
    reset-view,
    fit-to-content,
    save-png,
    copy-image,
    toggle-interaction,
    view-isometric,
    view-front,
    view-back,
    view-left,
    view-right,
    view-top,
    view-bottom,
}

export struct RuvizSlotState {
    source: image,
    /// Interaction overlay stacked over `source` in the same fitted geometry.
    ///
    /// The controller publishes it separately so an overlay-only redraw never
    /// re-uploads the base layer. An empty image means "no overlay".
    overlay: image,
    interactive: bool,
    is-3d: bool,
    has-frame: bool,
    device-scale: float,
    image-fit: RuvizImageFit,
}

/// Application-wide bridge shared by every `RuvizPlot` in one Slint component
/// tree. The Rust controller owns the slots model and callback handlers.
export global RuvizRuntime {
    in-out property <[RuvizSlotState]> slots;
    /// Announces that this component stacks `overlay` over `source`.
    ///
    /// The controller keeps publishing one flat, pre-composed image in `source`
    /// until a component says otherwise, so a component that binds `source`
    /// alone never loses its interaction overlay. `RuvizPlot` announces itself;
    /// a custom component that draws `overlay` must call this from its `init`.
    callback overlay-supported(slot-id: int);
    callback resized(slot-id: int, width: float, height: float, device-scale: float);
    callback pointer-event(
        slot-id: int,
        kind: int,
        button: int,
        x: float,
        y: float,
    ) -> bool;
    callback context-action(slot-id: int, action: RuvizContextAction);
    callback wheel-event(
        slot-id: int,
        delta-x: float,
        delta-y: float,
        x: float,
        y: float,
    ) -> bool;
    callback double-clicked(slot-id: int, x: float, y: float);
    callback escape(slot-id: int);
    callback focus-lost(slot-id: int);
}

/// Image-backed native ruviz presentation surface.
///
/// The Rust `RuvizController` supplies frames and handles callbacks. `slot-id`
/// allows any number of components to share one retained controller.
export component RuvizPlot inherits Rectangle {
    in property <int> slot-id;
    private property <bool> slot-valid:
        root.slot-id >= 0 && root.slot-id < RuvizRuntime.slots.length;
    private property <bool> interactive:
        root.slot-valid && RuvizRuntime.slots[root.slot-id].interactive;
    private property <bool> is-3d:
        root.slot-valid && RuvizRuntime.slots[root.slot-id].is-3d;
    private property <bool> has-frame:
        root.slot-valid && RuvizRuntime.slots[root.slot-id].has-frame;
    private property <float> device-scale:
        root.slot-valid ? RuvizRuntime.slots[root.slot-id].device-scale : 1.0;
    private property <RuvizImageFit> image-fit:
        root.slot-valid ? RuvizRuntime.slots[root.slot-id].image-fit : RuvizImageFit.contain;
    private property <ImageFit> fitting:
        root.image-fit == RuvizImageFit.cover ? ImageFit.cover :
        root.image-fit == RuvizImageFit.fill ? ImageFit.fill :
        ImageFit.contain;

    min-width: 1px;
    min-height: 1px;
    clip: true;

    // Announced from both places because only one of them can fire: a
    // repeated instance is created with a valid slot, while a statically
    // placed one is created before the controller is attached.
    init => {
        RuvizRuntime.overlay-supported(root.slot-id);
    }

    changed width => {
        RuvizRuntime.resized(root.slot-id, root.width / 1px, root.height / 1px, root.device-scale);
    }
    changed height => {
        RuvizRuntime.resized(root.slot-id, root.width / 1px, root.height / 1px, root.device-scale);
    }
    changed device-scale => {
        RuvizRuntime.resized(root.slot-id, root.width / 1px, root.height / 1px, root.device-scale);
    }
    changed slot-valid => {
        if (root.slot-valid) {
            RuvizRuntime.overlay-supported(root.slot-id);
            RuvizRuntime.resized(root.slot-id, root.width / 1px, root.height / 1px, root.device-scale);
        }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: root.slot-valid ? RuvizRuntime.slots[root.slot-id].source : @image-url("");
        image-fit: root.fitting;
    }

    // Same geometry and fit as the base layer, so the renderer composites the
    // two on the GPU instead of the controller blending them per pixel.
    Image {
        width: parent.width;
        height: parent.height;
        source: root.slot-valid ? RuvizRuntime.slots[root.slot-id].overlay : @image-url("");
        image-fit: root.fitting;
    }

    context-menu := ContextMenuArea {
        width: parent.width;
        height: parent.height;
        enabled: root.slot-valid;

        Menu {
            MenuItem {
                title: @tr("Reset View");
                enabled: root.has-frame;
                activated => {
                    RuvizRuntime.context-action(root.slot-id, RuvizContextAction.reset-view);
                }
            }
            MenuItem {
                title: @tr("Fit to Content");
                enabled: root.has-frame;
                activated => {
                    RuvizRuntime.context-action(root.slot-id, RuvizContextAction.fit-to-content);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Save PNG…");
                enabled: root.has-frame;
                activated => {
                    RuvizRuntime.context-action(root.slot-id, RuvizContextAction.save-png);
                }
            }
            MenuItem {
                title: @tr("Copy Image");
                enabled: root.has-frame;
                activated => {
                    RuvizRuntime.context-action(root.slot-id, RuvizContextAction.copy-image);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: root.interactive ? @tr("Disable Interaction") : @tr("Enable Interaction");
                checked: root.interactive;
                activated => {
                    RuvizRuntime.context-action(
                        root.slot-id,
                        RuvizContextAction.toggle-interaction,
                    );
                }
            }
            if root.is-3d: Menu {
                title: @tr("3D View");
                MenuItem {
                    title: @tr("Isometric");
                    activated => {
                        RuvizRuntime.context-action(
                            root.slot-id,
                            RuvizContextAction.view-isometric,
                        );
                    }
                }
                MenuItem {
                    title: @tr("Front");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-front);
                    }
                }
                MenuItem {
                    title: @tr("Back");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-back);
                    }
                }
                MenuItem {
                    title: @tr("Left");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-left);
                    }
                }
                MenuItem {
                    title: @tr("Right");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-right);
                    }
                }
                MenuItem {
                    title: @tr("Top");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-top);
                    }
                }
                MenuItem {
                    title: @tr("Bottom");
                    activated => {
                        RuvizRuntime.context-action(root.slot-id, RuvizContextAction.view-bottom);
                    }
                }
            }
        }

        input := FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: root.slot-valid;

            focus-lost(_) => {
                RuvizRuntime.focus-lost(root.slot-id);
            }

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    RuvizRuntime.escape(root.slot-id);
                    accept
                } else {
                    reject
                }
            }

            TouchArea {
                enabled: root.slot-valid;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        input.focus();
                    }
                    if (RuvizRuntime.pointer-event(
                        root.slot-id,
                        event.kind == PointerEventKind.down ? 0 :
                        event.kind == PointerEventKind.up ? 1 :
                        event.kind == PointerEventKind.move ? 2 : 3,
                        event.button == PointerEventButton.left ? 1 :
                        event.button == PointerEventButton.right ? 2 :
                        event.button == PointerEventButton.middle ? 3 : 0,
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                    )) {
                        context-menu.show({ x: self.mouse-x, y: self.mouse-y });
                    }
                }

                scroll-event(event) => {
                    if (RuvizRuntime.wheel-event(
                        root.slot-id,
                        event.delta-x / 1px,
                        event.delta-y / 1px,
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                    )) {
                        accept
                    } else {
                        reject
                    }
                }

                double-clicked => {
                    RuvizRuntime.double-clicked(
                        root.slot-id,
                        self.mouse-x / 1px,
                        self.mouse-y / 1px,
                    );
                }
            }
        }
    }
}

/// Responsive multi-slot grid backed by the shared `RuvizRuntime` model.
export component RuvizPlotGrid inherits Rectangle {
    in property <int> columns: 2;
    private property <int> safe-columns: max(1, root.columns);
    private property <int> rows:
        max(1, (RuvizRuntime.slots.length + root.safe-columns - 1) / root.safe-columns);
    private property <length> spacing: 8px;
    private property <length> cell-width:
        max(1px, (root.width - (root.safe-columns - 1) * root.spacing) / root.safe-columns);
    private property <length> cell-height:
        max(1px, (root.height - (root.rows - 1) * root.spacing) / root.rows);
    min-width: 1px;
    min-height: 1px;

    for slot[index] in RuvizRuntime.slots: RuvizPlot {
        slot-id: index;
        x: Math.mod(index, root.safe-columns) * (root.cell-width + root.spacing);
        y: (index / root.safe-columns) * (root.cell-height + root.spacing);
        width: root.cell-width;
        height: root.cell-height;
    }
}
